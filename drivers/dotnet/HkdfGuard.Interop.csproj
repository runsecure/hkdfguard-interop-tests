<Project Sdk="Microsoft.NET.Sdk">

  <!-- The .NET driver for the HkdfGuard interop matrix. The develop matrix references the sibling
       hkdfguard-dotnet checkout; swap these for PackageReferences to test the published packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\hkdfguard-dotnet\src\HkdfGuard.Abstractions\HkdfGuard.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\hkdfguard-dotnet\src\HkdfGuard.CryptoProvider.AesGcm256\HkdfGuard.CryptoProvider.AesGcm256.csproj" />
    <ProjectReference Include="..\..\..\hkdfguard-dotnet\src\HkdfGuard.DataEncryptionKey\HkdfGuard.DataEncryptionKey.csproj" />
    <ProjectReference Include="..\..\..\hkdfguard-dotnet\src\HkdfGuard.KeyWrapping.V1\HkdfGuard.KeyWrapping.V1.csproj" />
  </ItemGroup>

</Project>
