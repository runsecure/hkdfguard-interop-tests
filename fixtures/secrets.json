        "plaintext": "k-0123456789abcdef"
      },
      {
        "name": "Prod/Db",
        "fileName": "Prod__Db",
        "plaintext": "upper-case store name",
        "alsoReadAs": [
          "prod__db"
        ]
      },
      {
        "name": "certs/unicode",
        "fileName": "certs__unicode",
        "plaintext": "pässwörd · 日本語 · 🔐"
      },
      {
        "name": "brace",
        "fileName": "brace",
        "plaintext": "{not json"
      }
    ],
    "missing": [
      "gone",
      "prod/app#absent",
      "prod/app#empty",
