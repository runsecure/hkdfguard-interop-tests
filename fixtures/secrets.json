        "plaintext": "true"
      },
      {
        "name": "prod/app#escaped",
        "fileName": "prod__app__escaped",
        "plaintext": "line one\nline two é \"quoted\" /"
      },
      {
        "name": "prod/app#greeting",
        "fileName": "prod__app__greeting",
        "plaintext": "grüße · 日本語 · 🔐"
      },
      {
        "name": "prod/api-key",
